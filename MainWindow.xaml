<Window
    x:Class="TXT2IMG.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TXT2IMG"
    mc:Ignorable="d"
    Title="TXT2IMG">
    <Grid x:Name="RootGrid" Padding="24" SizeChanged="RootGrid_SizeChanged">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF15141A" Offset="0" />
                <GradientStop Color="#FF1E1D26" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Grid.Row="0" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Height="60" MinHeight="60" MaxHeight="60" VerticalAlignment="Center"
                            Background="#FF2A2939" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="2"
                            PointerWheelChanged="PromptBox_PointerWheelChanged">
                        <TextBox x:Name="PromptTextBox"
                                 PlaceholderText="Describe what you want — Enter generates, Shift+Enter new line"
                                 Background="Transparent" Foreground="White" PlaceholderForeground="#FF9A99AC"
                                 BorderThickness="0" CornerRadius="0"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                 FontSize="15" Padding="12,8,16,8"
                                 TextWrapping="Wrap"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 GotFocus="PromptTextBox_GotFocus"
                                 SelectionChanged="PromptTextBox_SelectionChanged"
                                 TextChanged="PromptTextBox_TextChanged"
                                 KeyDown="PromptTextBox_KeyDown">
                            <!-- Built-in text context menu pulls TabView theme keys (crashes unpackaged). -->
                            <TextBox.ContextFlyout>
                                <MenuFlyout Opening="PromptTextContextFlyout_Opening">
                                    <MenuFlyoutItem x:Name="PromptCutMenuItem" Text="Cut"
                                                    Click="PromptContextCut_Click" />
                                    <MenuFlyoutItem x:Name="PromptCopyMenuItem" Text="Copy"
                                                    Click="PromptContextCopy_Click" />
                                    <MenuFlyoutItem x:Name="PromptPasteMenuItem" Text="Paste"
                                                    Click="PromptContextPaste_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Select all"
                                                    Click="PromptContextSelectAll_Click" />
                                </MenuFlyout>
                            </TextBox.ContextFlyout>
                        </TextBox>
                    </Border>
                    <Button x:Name="GenerateButton" Grid.Row="0" Grid.Column="1" Content="Generate" Width="140" Height="40"
                            Margin="10,0,0,0" VerticalAlignment="Center" Click="GenerateButton_Click"
                            Background="{StaticResource AccentGradientBrush}" Foreground="White"
                            FontWeight="SemiBold" FontSize="13" CornerRadius="10" />
                <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Grid.Row="0" Margin="10,0,0,6" Text="Graphics style"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Grid.Row="0" Margin="10,0,0,6" Text="Aspect ratio"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Grid.Row="0" Margin="10,0,0,6" Text="Resolution"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                               HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Prompts and images stay on this PC — generation is local."
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                        <TextBlock x:Name="NewVariationHintText" Visibility="Collapsed"
                                   Text='"New Variation" — Creates a new take on the selected image.'
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="FirstRunDownloadText" Visibility="Collapsed"
                                   Text="First run downloads the model (this can take some time)."
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <ComboBox x:Name="StyleComboBox" Grid.Column="1" Grid.Row="1" Margin="10,0,0,0"
                              Width="170" Height="40" MaxDropDownHeight="420"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Art style preset applied to your prompt"
                              SelectionChanged="StyleComboBox_SelectionChanged" DropDownOpened="ScrollableComboBox_DropDownOpened"
                              BorderBrush="{StaticResource StyleAccentBrush}" BorderThickness="2"
                              ItemContainerStyle="{StaticResource PointerOnlyComboBoxItemStyle}" />
                    <ComboBox x:Name="AspectComboBox" Grid.Column="2" Grid.Row="1" Margin="10,0,0,0"
                              Width="170" Height="40" SelectedIndex="1" VerticalAlignment="Center"
                              ToolTipService.ToolTip="Shape of the generated image"
                              SelectionChanged="AspectComboBox_SelectionChanged">
                        <ComboBoxItem Content="Square" />
                        <ComboBoxItem Content="Landscape (16:9)" />
                        <ComboBoxItem Content="Portrait (9:16)" />
                        <ComboBoxItem Content="Landscape (4:3)" />
                        <ComboBoxItem Content="Portrait (3:4)" />
                    </ComboBox>
                    <ComboBox x:Name="ResolutionComboBox" Grid.Column="3" Grid.Row="1" Margin="10,0,0,0"
                              Width="130" Height="40" VerticalAlignment="Center"
                              ToolTipService.ToolTip="768 or 896 px long edge (896 is the GPU maximum)." />
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Orientation="Vertical" Spacing="2"
                            VerticalAlignment="Center" Width="140">
                    <!-- Spacer keeps 4K on the lower row (aligned under the control stack). -->
                    <Border Height="24" Opacity="0" IsHitTestVisible="False" />
                    <CheckBox x:Name="Upscale4KCheckBox" Content="4K upscale" Foreground="White"
                              HorizontalAlignment="Center"
                              ToolTipService.ToolTip="After each image, resize to 3840 px long edge (CPU). Export size only — not GPU resolution." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="12" Grid.Row="0">
                <Grid x:Name="PreviewCardGrid" SizeChanged="PreviewCardGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Preview" FontSize="18" Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,8" />

                    <Grid x:Name="PreviewImageHost" Grid.Row="1">
                        <Border x:Name="PreviewBorder" Background="#FF121116" CornerRadius="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="PreviewPlaceholderText" Text="Your image will appear here"
                                           Foreground="#FF55536A" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="WrapWholeWords"
                                           Margin="10" IsHitTestVisible="False" />
                                <Image x:Name="PreviewImage" Stretch="Uniform"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <Border x:Name="PreviewHoverBorder" BorderBrush="Transparent" BorderThickness="3" CornerRadius="14"
                                        IsHitTestVisible="False" />
                                <Button x:Name="PreviewImageButton" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        Click="PreviewImage_Click" ToolTipService.ToolTip="Click to copy to clipboard"
                                        PointerEntered="PreviewImageButton_PointerEntered" PointerExited="PreviewImageButton_PointerExited">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </Button.Resources>
                                </Button>
                                <Border x:Name="CopiedToast" Background="{StaticResource AccentGradientBrush}" CornerRadius="18" Padding="18,8"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Opacity="0" IsHitTestVisible="False">
                                    <TextBlock Text="Copied!" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="2"
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="CopyButton" Content="Copy to Clipboard" Width="160" Height="40" Click="CopyButton_Click"
                                Background="{StaticResource AccentGradientBrush}" Foreground="White" FontWeight="SemiBold" CornerRadius="10" />
                        <Button x:Name="SaveButton" Content="Save as PNG" Width="130" Height="40" Click="SaveButton_Click" CornerRadius="10" />
                        <Button x:Name="VaryButton" Content="New Variation" Width="130" Height="40" Click="VaryButton_Click" CornerRadius="10"
                                ToolTipService.ToolTip="Img2img variation from the selected result (stored prompt and layout, new details)" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ResultsCardBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,10" Grid.Row="1" Margin="0,12,0,0" SizeChanged="ResultsCardBorder_SizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="ResultsSpacerColumn" Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Results" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Jeff Molofee (NeHe) 2026" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <Border x:Name="StyleDescriptionBorder" Background="#FF121116" BorderBrush="{StaticResource StyleAccentBrush}" BorderThickness="2" CornerRadius="12" Margin="0,8,0,0" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="StyleDescriptionText" Foreground="#FF9A99AC" FontSize="11"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="6" />
                    </Border>

                    <ItemsControl x:Name="ResultsPanel" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ResultItem">
                                <Grid Width="{x:Bind SlotWidth, Mode=OneWay}" Height="{x:Bind SlotHeight, Mode=OneWay}">
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Background="{StaticResource ResultSlotBackgroundBrush}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Grid>
                                            <TextBlock Text="{x:Bind SlotMark, Mode=OneWay}" FontSize="28" Foreground="{x:Bind SlotMarkBrush, Mode=OneWay}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="{x:Bind SlotImageStretch, Mode=OneWay}"
                                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            <Button Tag="{x:Bind}" Click="ResultSlot_Click" Background="Transparent" BorderThickness="0" Padding="0"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    ToolTipService.ToolTip="{x:Bind Hint, Mode=OneWay}">
                                                <Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{x:Bind ActiveBrush, Mode=OneWay}" BorderThickness="3" CornerRadius="12" IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>