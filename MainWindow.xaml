<Window
    x:Class="TXT2IMG.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TXT2IMG"
    mc:Ignorable="d"
    Title="TXT2IMG">
    <Grid Padding="24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF15141A" Offset="0" />
                <GradientStop Color="#FF1E1D26" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Grid.Row="0" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptTextBox" Grid.Column="0" Height="44" PlaceholderText="Describe what you want, then press Enter" Background="#FF2A2939" Foreground="White" PlaceholderForeground="#FF9A99AC" BorderBrush="{StaticResource CardBorderBrush}" VerticalAlignment="Center" FontSize="15" KeyDown="PromptTextBox_KeyDown" />
                    <Button x:Name="GenerateButton" Grid.Column="1" Content="Generate" Width="140" Height="44" Margin="10,0,0,0" Click="GenerateButton_Click" Background="{StaticResource AccentGradientBrush}" Foreground="White" FontWeight="SemiBold" FontSize="13" CornerRadius="12" />
                </Grid>
                <!-- Columns mirror the row above: the controls share the prompt box's column so the
                     aspect box ends on its right edge, and Max Detail sits in a column the width of
                     the Generate button, lining the two rows up into two visual columns. -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Prompts and images stay on this PC — generation is local. (First run will download the model.)" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <ComboBox x:Name="StyleComboBox" Grid.Column="1" Width="170" Height="40" Margin="10,0,0,0" SelectedIndex="0" MaxDropDownHeight="420" ToolTipService.ToolTip="Style" SelectionChanged="StyleComboBox_SelectionChanged" DropDownOpened="ScrollableComboBox_DropDownOpened" BorderBrush="{StaticResource StyleAccentBrush}" BorderThickness="2" ItemContainerStyle="{StaticResource PointerOnlyComboBoxItemStyle}">
                            <!-- Deliberately shorter than the full style list. A popup taller than the
                                 window gets clipped by it, yet its own ScrollViewer still measures a
                                 viewport tall enough for every item — so it reports nothing to scroll and
                                 the clipped entries become unreachable. A height the window can always
                                 honor keeps the ScrollViewer genuinely scrollable; the wheel then works
                                 through ScrollableComboBox_DropDownOpened's WinUI routing workaround. -->
                            <ComboBoxItem Content="None" />
                            <ComboBoxItem Content="3D Render" />
                            <ComboBoxItem Content="Anime" />
                            <ComboBoxItem Content="Black &amp; White" />
                            <ComboBoxItem Content="Cartoon" />
                            <ComboBoxItem Content="Claymation" />
                            <ComboBoxItem Content="Comic Book" />
                            <ComboBoxItem Content="Colorful Vector" />
                            <ComboBoxItem Content="Concept Art" />
                            <ComboBoxItem Content="Cyberpunk" />
                            <ComboBoxItem Content="Dark Fantasy" />
                            <ComboBoxItem Content="Fantasy Art" />
                            <ComboBoxItem Content="Futuristic" />
                            <ComboBoxItem Content="Graphic Oil" />
                            <ComboBoxItem Content="Icon" />
                            <ComboBoxItem Content="Minimalist" />
                            <ComboBoxItem Content="New Impasto" />
                            <ComboBoxItem Content="Oil Painting" />
                            <ComboBoxItem Content="Pixel Art" />
                            <ComboBoxItem Content="Soft Oil" />
                            <ComboBoxItem Content="Vintage Photo" />
                            <ComboBoxItem Content="Watercolor" />
                        </ComboBox>
                        <ComboBox x:Name="AspectComboBox" Grid.Column="2" Width="170" Height="40" Margin="10,0,0,0" SelectedIndex="1" ToolTipService.ToolTip="Aspect ratio" SelectionChanged="AspectComboBox_SelectionChanged">
                            <ComboBoxItem Content="Square" />
                            <ComboBoxItem Content="Landscape (16:9)" />
                            <ComboBoxItem Content="Portrait (9:16)" />
                            <ComboBoxItem Content="Landscape (4:3)" />
                            <ComboBoxItem Content="Portrait (3:4)" />
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Column="1" Width="140" Margin="10,0,0,0">
                        <CheckBox x:Name="MaxDetailCheckBox" Content="Max Detail"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"
                                  ToolTipService.ToolTip="More inference steps — slower, often cleaner anatomy and detail" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <!-- Preview takes all leftover height; Results is a compact Auto strip sized from a
                 fixed thumbnail budget (not a star share), so the window doesn't need to be
                 very tall for the preview to look decent. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="12" Grid.Row="0">
                <Grid x:Name="PreviewCardGrid" SizeChanged="PreviewCardGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Preview" FontSize="18" Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,8" />

                    <Grid x:Name="PreviewImageHost" Grid.Row="1">
                        <Border x:Name="PreviewBorder" Background="#FF121116" CornerRadius="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="PreviewPlaceholderText" Text="Your image will appear here"
                                           Foreground="#FF55536A" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button x:Name="PreviewImageButton" Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                        Click="PreviewImage_Click" ToolTipService.ToolTip="Click to copy to clipboard"
                                        PointerEntered="PreviewImageButton_PointerEntered" PointerExited="PreviewImageButton_PointerExited">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    </Button.Resources>
                                    <Border x:Name="PreviewHoverBorder" BorderBrush="Transparent" BorderThickness="3" CornerRadius="14">
                                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                                    </Border>
                                </Button>
                                <Border x:Name="CopiedToast" Background="{StaticResource AccentGradientBrush}" CornerRadius="18" Padding="18,8"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Opacity="0" IsHitTestVisible="False">
                                    <TextBlock Text="Copied!" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="2"
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="CopyButton" Content="Copy to Clipboard" Width="160" Height="40" Click="CopyButton_Click"
                                Background="{StaticResource AccentGradientBrush}" Foreground="White" FontWeight="SemiBold" CornerRadius="10" />
                        <Button x:Name="SaveButton" Content="Save as PNG" Width="130" Height="40" Click="SaveButton_Click" CornerRadius="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="ResultsCardBorder" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,10" Grid.Row="1" Margin="0,12,0,0" SizeChanged="ResultsCardBorder_SizeChanged">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="ResultsSpacerColumn" Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Results" FontSize="13" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Jeff Molofee (NeHe) 2026" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <Border x:Name="StyleDescriptionBorder" Background="#FF121116" BorderBrush="{StaticResource StyleAccentBrush}" BorderThickness="2" CornerRadius="12" Margin="0,8,0,0" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="StyleDescriptionText" Foreground="#FF9A99AC" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="8" />
                    </Border>

                    <ItemsControl x:Name="ResultsPanel" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ResultItem">
                                <Grid Width="96" Height="96">
                                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Background="{StaticResource ResultSlotBackgroundBrush}">
                                        <Grid>
                                            <TextBlock Text="+" FontSize="28" Foreground="#FF6A6A6A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Button Tag="{x:Bind}" Click="ResultSlot_Click" Background="Transparent" BorderThickness="0" Padding="0"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    ToolTipService.ToolTip="{x:Bind Hint, Mode=OneWay}">
                                                <Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                                </Button.Resources>
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{x:Bind ActiveBrush, Mode=OneWay}" BorderThickness="3" CornerRadius="12" IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
